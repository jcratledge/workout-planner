# Copy this file to .env and fill in your Supabase project's values.
# Find both under Supabase dashboard -> Settings -> API.
# The anon key is safe to expose in client code — it's designed for that;
# Row Level Security is what actually protects your data.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
